{
  "family": "fixguru-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::530159932918:role/fixguru-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::530159932918:role/fixguru-ecs-task-role",
  "containerDefinitions": [
    {
      "name": "fixguru-api",
      "image": "530159932918.dkr.ecr.ap-south-1.amazonaws.com/fixguru-api:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "RAILS_ENV",        "value": "production" },
        { "name": "RAILS_MAX_THREADS","value": "5" },
        { "name": "WEB_CONCURRENCY", "value": "2" },
        { "name": "PORT",             "value": "3000" }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:530159932918:secret:fixguru/secrets-V3ZcDG:DATABASE_URL::"
        },
        {
          "name": "SECRET_KEY_BASE",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:530159932918:secret:fixguru/secrets-V3ZcDG:SECRET_KEY_BASE::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/fixguru-api",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:3000/up || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      }
    }
  ]
}
